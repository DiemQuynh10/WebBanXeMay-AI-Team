@model WebBanXeMay.Models.ApplicationUser
@{
    ViewData["Title"] = "Thông tin cá nhân";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4 mx-auto" style="max-width: 600px;">
        <div class="card-body p-4 text-center">

            <h3 class="mb-4 text-primary fw-bold">Thông tin cá nhân</h3>

            <div class="mb-3">
                <img src="~/uploads/@(Model.AnhDaiDien ?? "default-avatar.png")"
                     class="rounded-circle border border-2"
                     width="120" height="120" style="object-fit: cover;" />
            </div>

            <div class="mb-3 text-start">
                <label class="form-label fw-semibold">Tên hiển thị:</label>
                <input type="text" class="form-control" value="@Model.TenHienThi" readonly />
            </div>

            <div class="mb-3 text-start">
                <label class="form-label fw-semibold">Email:</label>
                <input type="text" class="form-control" value="@Model.Email" readonly />
            </div>

            <div class="mb-3 text-start">
                <label class="form-label fw-semibold">Số điện thoại:</label>
                <input type="text" class="form-control" value="@Model.PhoneNumber" readonly />
            </div>

            <div class="d-flex justify-content-center mt-4 gap-3">
                <a asp-area="Admin" asp-controller="Account" asp-action="EditProfile"
                   class="btn btn-pink text-white px-4 py-2"
                   style="background-color:#e91e63; border:none; border-radius:8px;">
                    <i class="fas fa-edit me-1"></i> Sửa thông tin
                </a>

                <a asp-controller="Home" asp-action="Index"
                   class="btn btn-secondary px-4 py-2"
                   style="border-radius:8px;">
                    <i class="fas fa-arrow-left me-1"></i> Quay lại
                </a>
            </div>
        </div>
    </div>
</div>