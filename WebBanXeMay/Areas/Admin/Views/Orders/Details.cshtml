@model WebBanXeMay.Areas.Admin.ViewModels.OrderDetailViewModel

@{
    ViewData["Title"] = "Chi tiết Đơn hàng #" + Model.OrderId;

    var hasDeposit = Model.DepositAmount.HasValue && Model.DepositAmount.Value > 0;
    var deposit = hasDeposit ? Model.DepositAmount.Value : 0m;
    decimal remaining = hasDeposit
        ? (Model.RemainingAmount ?? (Model.TotalAmount - deposit))
        : Model.TotalAmount;

    string depositStatus = Model.DepositStatus ?? "";
    string status = Model.Status ?? "";

    bool isFinishedOrder = status == "HoanTat";
    bool isCanceledOrder = status == "DaHuy";

    // Badge trạng thái tinh tế hơn
    string statusBadgeClass = status switch
    {
        "ChoXacNhan" => "bg-warning text-dark",
        "DangXuLy" => "bg-info text-dark",
        "DangGiao" => "bg-primary",
        "HoanTat" => "bg-success",
        "DaHuy" => "bg-secondary",
        _ => "bg-secondary"
    };
}

<style>
    /* CSS Timeline tối giản */
    .timeline {
        border-left: 2px solid #e3e6f0;
        padding-left: 20px;
        list-style: none;
        margin-left: 10px;
    }

    .timeline-item {
        position: relative;
        margin-bottom: 1rem;
    }

        .timeline-item::before {
            content: '';
            position: absolute;
            left: -27px;
            top: 4px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background-color: #fff;
            border: 3px solid #d1d3e2;
        }

        .timeline-item.active::before {
            border-color: #4e73df;
        }

    /* Text Styles */
    .text-label {
        font-size: 0.8rem;
        color: #858796;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
    }

    .text-value {
        font-weight: 600;
        color: #5a5c69;
    }

    .card-header-clean {
        background: #fff;
        border-bottom: 1px solid #e3e6f0;
        padding: 1rem 1.25rem;
    }

    .img-thumb-sm {
        width: 50px;
        height: 50px;
        object-fit: cover;
        border-radius: 6px;
        border: 1px solid #eaecf4;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center">
        <a asp-action="Index" class="btn btn-light border shadow-sm me-3 text-secondary">
            <i class="fas fa-arrow-left"></i>
        </a>
        <div>
            <h1 class="h4 mb-0 text-gray-800 fw-bold">Đơn hàng #@Model.OrderId</h1>
            <div class="mt-1">
                <span class="badge @statusBadgeClass fw-normal">@status</span>
                <span class="text-muted small ms-2"><i class="far fa-clock me-1"></i>@Model.OrderDate.ToString("HH:mm, dd/MM/yyyy")</span>
            </div>
        </div>
    </div>
</div>

<div class="row mb-5">
    <div class="col-xl-8 col-lg-7">

        <div class="card shadow-sm mb-4 border-0">
            <div class="card-header-clean">
                <h6 class="m-0 font-weight-bold text-gray-800">Danh sách sản phẩm</h6>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="bg-light text-gray-600 small">
                        <tr>
                            <th class="ps-4 py-3 border-0">Sản phẩm</th>
                            <th class="text-center py-3 border-0">SL</th>
                            <th class="text-end py-3 border-0">Đơn giá</th>
                            <th class="text-end pe-4 py-3 border-0">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-4 border-bottom-0">
                                    <div class="d-flex align-items-center">
                                        <img src="@item.ImageUrl" class="img-thumb-sm me-3" />
                                        <span class="fw-bold text-dark">@item.ProductName</span>
                                    </div>
                                </td>
                                <td class="text-center border-bottom-0">x @item.Quantity</td>
                                <td class="text-end border-bottom-0">@item.UnitPrice.ToString("N0")</td>
                                <td class="text-end pe-4 border-bottom-0 fw-bold text-dark">@item.TotalPrice.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="bg-light">
                        <tr>
                            <td colspan="3" class="text-end py-3 text-label">Tổng tiền hàng:</td>
                            <td class="text-end pe-4 py-3 fw-bold text-dark">@Model.TotalAmount.ToString("N0") ₫</td>
                        </tr>
                        @if (hasDeposit)
                        {
                            <tr>
                                <td colspan="3" class="text-end py-1 text-label text-success border-0">Đã đặt cọc:</td>
                                <td class="text-end pe-4 py-1 text-success border-0">- @deposit.ToString("N0") ₫</td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-end py-3 text-label text-primary border-0 pt-1">Cần thanh toán:</td>
                                <td class="text-end pe-4 py-3 h5 fw-bold text-primary border-0 pt-1">@remaining.ToString("N0") ₫</td>
                            </tr>
                        }
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="row">

            <div class="col-md-6">
                <div class="card shadow-sm mb-4 h-100 border-0">
                    <div class="card-header-clean d-flex justify-content-between align-items-center">
                        <h6 class="m-0 font-weight-bold text-gray-800">Thông tin Đặt cọc</h6>
                        @if (hasDeposit)
                        {
                            string badgeClass = "bg-secondary";
                            if (depositStatus == "ChoXacNhanCoc") badgeClass = "bg-warning text-dark";
                            else if (depositStatus == "DaCoc") badgeClass = "bg-success";
                            else if (depositStatus == "HoanCoc" || depositStatus == "MatCoc") badgeClass = "bg-light text-muted border";
                            <span class="badge @badgeClass rounded-pill">@depositStatus</span>
                        }
                    </div>
                    <div class="card-body">
                        @if (!hasDeposit)
                        {
                            <div class="text-center text-muted py-4">
                                <i class="fas fa-check-circle mb-2"></i><br>Không yêu cầu cọc
                            </div>
                        }
                        else
                        {
                            // --- 🔥 PHẦN CẢNH BÁO QUÁ HẠN ĐƯỢC THÊM VÀO ĐÂY 🔥 ---
                            @if (Model.IsDepositOverdue)
                            {
                                <div class="alert alert-danger d-flex align-items-center mb-3 p-2 shadow-sm" role="alert" style="border-left: 4px solid #e74a3b;">
                                    <i class="fas fa-exclamation-triangle fa-2x me-3 text-danger"></i>
                                    <div>
                                        <strong class="text-uppercase text-danger" style="font-size: 0.85rem;">Quá hạn đặt cọc!</strong>
                                        <div class="small text-dark">Vui lòng kiểm tra và xử lý ngay.</div>
                                    </div>
                                </div>
                            }
                            // ----------------------------------------------------

                            <div class="mb-3">
                                <div class="row mb-2">
                                    <div class="col-5 text-label">Số tiền:</div>
                                    <div class="col-7 text-value">@deposit.ToString("N0") ₫</div>
                                </div>
                                <div class="row mb-2">
                                    <div class="col-5 text-label">Hình thức:</div>
                                    <div class="col-7 text-value">@Model.DepositMethod</div>
                                </div>
                                @if (Model.DepositDueDate.HasValue)
                                {
                                    <div class="row mb-2">
                                        <div class="col-5 text-label">Hạn nộp:</div>
                                        <div class="col-7 text-value @(Model.IsDepositOverdue ? "text-danger fw-bold" : "text-danger")">
                                            @Model.DepositDueDate.Value.ToString("dd/MM HH:mm")
                                        </div>
                                    </div>
                                }
                            </div>

                            @if (!isFinishedOrder && !isCanceledOrder)
                            {
                                <hr class="my-3 opacity-25">
                                @if (depositStatus == "ChoXacNhanCoc")
                                {
                                    <div class="d-grid gap-2">
                                        <form asp-action="ConfirmDeposit" method="post" onsubmit="return confirm('Xác nhận đã nhận tiền?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@Model.OrderId" />
                                            <button class="btn btn-success btn-sm w-100">Xác nhận đã nhận</button>
                                        </form>
                                        <form asp-action="LoseDeposit" method="post" onsubmit="return confirm('Hủy cọc?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@Model.OrderId" />
                                            <button class="btn btn-light btn-sm w-100 text-danger border">Hủy (Mất cọc)</button>
                                        </form>
                                    </div>
                                }
                                else if (depositStatus == "DaCoc")
                                {
                                    <div class="btn-group w-100 btn-group-sm">
                                        <form asp-action="RefundDeposit" method="post" class="w-50" onsubmit="return confirm('Hoàn cọc?');">
                                            @Html.AntiForgeryToken() <input type="hidden" name="id" value="@Model.OrderId" />
                                            <button class="btn btn-outline-secondary w-100">Hoàn cọc</button>
                                        </form>
                                        <form asp-action="LoseDeposit" method="post" class="w-50" onsubmit="return confirm('Mất cọc?');">
                                            @Html.AntiForgeryToken() <input type="hidden" name="id" value="@Model.OrderId" />
                                            <button class="btn btn-outline-danger w-100">Mất cọc</button>
                                        </form>
                                    </div>
                                }
                            }
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card shadow-sm mb-4 h-100 border-0">
                    <div class="card-header-clean">
                        <h6 class="m-0 font-weight-bold text-gray-800">Lịch sử hoạt động</h6>
                    </div>
                    <div class="card-body p-3" style="max-height: 250px; overflow-y: auto;">
                        @if (Model.Logs != null && Model.Logs.Any())
                        {
                            <ul class="timeline mb-0">
                                @{
                                    var first = true;
                                }
                                @foreach (var log in Model.Logs.OrderByDescending(x => x.ThoiGian))
                                {
                                    <li class="timeline-item @(first ? "active" : "")">
                                        <div class="small text-muted mb-1">@log.ThoiGian.ToString("HH:mm dd/MM")</div>
                                        <span class="text-dark small">@log.NoiDung</span>
                                    </li>
                                    first = false;
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted small text-center">Chưa có lịch sử.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-4 col-lg-5">

        <div class="card shadow-sm mb-4 border-0">
            <div class="card-header-clean">
                <h6 class="m-0 font-weight-bold text-gray-800">Khách hàng & Giao nhận</h6>
            </div>
            <div class="card-body">
                <div class="d-flex mb-3">
                    <div class="me-3 text-center" style="width: 30px;">
                        <i class="fas fa-user text-gray-400 fa-lg"></i>
                    </div>
                    <div>
                        <div class="text-label">Người mua</div>
                        <div class="fw-bold text-dark">@Model.CustomerName</div>
                    </div>
                </div>

                <div class="d-flex mb-3">
                    <div class="me-3 text-center" style="width: 30px;">
                        <i class="fas fa-map-marker-alt text-gray-400 fa-lg"></i>
                    </div>
                    <div>
                        <div class="text-label">Người nhận</div>
                        <div class="text-dark fw-bold">@Model.ShippingRecipient</div>
                        <div class="text-dark small mt-1">@Model.ShippingAddress</div>
                    </div>
                </div>

                <div class="d-flex">
                    <div class="me-3 text-center" style="width: 30px;">
                        <i class="fas fa-phone text-gray-400 fa-lg"></i>
                    </div>
                    <div>
                        <div class="text-label">Liên hệ</div>
                        <a href="tel:@Model.ShippingPhone" class="text-decoration-none fw-bold text-dark">@Model.ShippingPhone</a>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.Reviews != null && Model.Reviews.Any())
        {
            <div class="card shadow-sm border-0">
                <div class="card-header-clean">
                    <h6 class="m-0 font-weight-bold text-gray-800">Đánh giá</h6>
                </div>
                <div class="card-body">
                    @foreach (var review in Model.Reviews)
                    {
                        <div class="bg-light p-3 rounded mb-2">
                            <div class="d-flex justify-content-between">
                                <strong class="small text-dark">@review.ProductName</strong>
                                <div class="text-warning small">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="@(i <= review.Rating ? "fas" : "far") fa-star"></i>
                                    }
                                </div>
                            </div>
                            <p class="small text-muted mt-2 mb-0 fst-italic">"@review.Comment"</p>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var successMsg = '@Html.Raw(TempData["SuccessMessage"] ?? TempData["Success"])';
        var errorMsg = '@Html.Raw(TempData["ErrorMessage"] ?? TempData["Error"])';

        // Cấu hình Toast (Thông báo góc trên bên phải)
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true,
            didOpen: (toast) => {
                toast.addEventListener('mouseenter', Swal.stopTimer)
                toast.addEventListener('mouseleave', Swal.resumeTimer)
            }
        });

        if (successMsg) {
            Toast.fire({
                icon: 'success',
                title: successMsg
            });
        }

        if (errorMsg) {
            Toast.fire({
                icon: 'error',
                title: errorMsg
            });
        }
    });
</script>