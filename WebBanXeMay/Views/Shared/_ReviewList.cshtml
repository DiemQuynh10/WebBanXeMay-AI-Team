@model IEnumerable<WebBanXeMay.Models.DanhGia>

@if (Model != null && Model.Any())
{
    <div>
        @foreach (var r in Model)
        {
            <div class="review-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <strong>
                            @r.SanPham?.TenSP
                        </strong>
                        <div class="star-rating" title="@r.DiemDanhGia">
                            @{
                                int filled = (int)Math.Round((double)r.DiemDanhGia);
                                for (int i = 1; i <= 5; i++)
                                {
                                    <span class="star">@((i <= filled) ? "★" : "☆")</span>
                                    ;
                                }
                            }
                        </div>
                    </div>
                    <small class="text-muted">@r.NgayDanhGia.ToString("dd/MM/yyyy")</small>
                </div>
                <div class="mt-2 text-muted">@r.NoiDung</div>
                <div class="mt-2 text-muted"><small>— @r.TenNguoiDanhGia</small></div>
            </div>
        }
    </div>
}
else
{
    <div class="text-muted">Chưa có đánh giá nào.</div>
}