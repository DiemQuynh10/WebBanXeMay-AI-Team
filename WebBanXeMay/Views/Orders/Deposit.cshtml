@using WebBanXeMay.Models
@model DonHang

@{
    ViewData["Title"] = "Đặt cọc đơn hàng #" + Model.MaDH;

    var soTienCoc = Model.SoTienCoc ?? 0m;
    var tongDon = Model.TongTien;
    var conLai = tongDon - soTienCoc;

    bool isNew = Model.TrangThaiCoc == TrangThaiCoc.ChuaCoc;
    bool isWaiting = Model.TrangThaiCoc == TrangThaiCoc.ChoXacNhanCoc;
    bool isDone = Model.TrangThaiCoc == TrangThaiCoc.DaCoc;

    // Màu hồng chủ đạo
    string primaryPink = "#e91e63";
    string lightPinkBg = "#fff7fb";
    string lightPinkBorder = "#f48fb1";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

<style>
    /* 1. KẾT CẤU CHUNG */
    .deposit-shell {
        max-width: 960px;
        margin: 20px auto 40px;
    }

    .deposit-card {
        border-radius: 1rem;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        border: none;
        overflow: hidden;
    }

    /* 2. HEADER */
    .deposit-header {
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid #f8bbd0;
        background: linear-gradient(90deg, #fff, #fce4ec);
    }

        .deposit-header h5 {
            margin: 0;
            font-weight: 700;
            color: #333;
        }

    /* 3. BODY & NỘI DUNG */
    .deposit-body {
        padding: 1.5rem;
    }

    .deposit-section-title {
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #9e9e9e;
        letter-spacing: .08em;
        margin-bottom: 0.75rem;
    }

    .deposit-info-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 2.5rem;
        font-size: 0.9rem;
    }

        .deposit-info-row span.label {
            font-weight: 600;
            color: #555;
        }

    /* 4. HƯỚNG DẪN & QR */
    .deposit-guide {
        font-size: 0.9rem;
        text-align: center;
        color: #777;
        padding: 1rem 1.5rem;
        border-radius: 0.75rem;
        background-color: @lightPinkBg;
        border: 1px dashed @lightPinkBorder;
        margin-bottom: 1.5rem;
    }

    .qr-box .deposit-section-title {
        color: @primaryPink;
    }

    .qr-box strong {
        color: #333;
    }

    /* 5. TRẠNG THÁI & NÚT */
    .deposit-status-box {
        padding: 1rem;
        border-radius: 0.6rem;
        font-size: 0.9rem;
        margin-bottom: 1.5rem;
    }

        .deposit-status-box strong {
            font-size: 1rem;
        }

        .deposit-status-box.waiting {
            background-color: #fff8e1;
            border: 1px solid #ffe082;
            color: #9c6c00;
        }

        .deposit-status-box.success {
            background-color: #e8f5e9;
            border: 1px solid #a5d6a7;
            color: #2e7d32;
        }

    .deposit-amount-big {
        font-size: 1.25rem;
        font-weight: 700;
        color: @primaryPink;
    }

    .btn-pink {
        background-color: @primaryPink;
        color: #fff;
        border-radius: 999px;
        border: none;
        padding-inline: 2rem;
        font-weight: 600;
    }

        .btn-pink:hover {
            background-color: #d81b60;
            color: #fff;
        }

    /* 6. SUMMARY */
    .deposit-summary {
        background-color: #f7f7f7;
        border-top: 1px solid #eee;
        padding: 1rem 1.5rem;
        font-size: 0.9rem;
    }

    /* 7. MODAL */
    .modal {
        display: none;
    }
</style>

<div class="deposit-shell">
    <div class="deposit-card">
        <div class="deposit-header d-flex justify-content-between align-items-center">
            <div>
                <h5 class="text-uppercase">Đặt cọc đơn hàng #@Model.MaDH</h5>
                <small class="text-secondary">
                    Ngày đặt: @Model.NgayDH.ToString("dd/MM/yyyy HH:mm")
                </small>
            </div>
            <div class="text-end">
                <div class="deposit-amount-big">@soTienCoc.ToString("N0") đ</div>
                <small class="text-secondary">Số tiền cần đặt cọc</small>
            </div>
        </div>

        <div class="deposit-body">
            <div class="mb-4 pb-3 border-bottom border-light">
                <div class="deposit-section-title">Thông tin đơn hàng</div>
                <div class="deposit-info-row">
                    <div>
                        <span class="label">Tổng đơn tạm tính: </span>
                        @tongDon.ToString("N0") đ
                    </div>
                    <div>
                        <span class="label">Hạn đặt cọc: </span>
                        <strong class="@(Model.HanCoc.HasValue && Model.HanCoc.Value < DateTime.Now ? "text-danger" : "text-dark")">
                            @Model.HanCoc?.ToString("dd/MM/yyyy HH:mm")
                        </strong>
                    </div>
                    <div>
                        <span class="label">Còn lại ước tính: </span>
                        <strong class="text-success">@conLai.ToString("N0") đ</strong>
                    </div>
                </div>
            </div>

            <div class="deposit-section-title mt-3">Hình thức thanh toán cọc</div>
            <div class="deposit-guide">
                <i class="bi bi-shield-lock-fill me-1" style="color: @primaryPink;"></i> Chuyển khoản / MoMo / VNPay theo thông tin shop cung cấp.<br />
                Sau khi chuyển khoản xong, hãy **bấm nút bên dưới** để báo shop kiểm tra và xác nhận cọc.
            </div>

            <div class="qr-box text-center my-4 p-4"
                 style="border:1px dashed @lightPinkBorder; border-radius:1rem; background:@lightPinkBg;">

                <div class="deposit-section-title mb-3" style="color:@primaryPink;">
                    <i class="bi bi-qr-code me-1"></i> QUÉT MÃ QR ĐỂ THANH TOÁN ĐẶT CỌC (MOMO · DEMO)
                </div>

                @{
                    var amountInt = (int)soTienCoc;
                    var qrUrl = $"https://img.vietqr.io/image/momo-0909886868-qr_only.png?amount={amountInt}&addInfo=DH{Model.MaDH}";
                    var transferNote = $"DH{Model.MaDH} - Dat coc";
                }

                <img src="@qrUrl"
                     alt="QR Thanh toán MoMo"
                     class="img-fluid rounded-3"
                     style="width:200px; height:200px; margin:0 auto 1rem; display:block;" />

                <div class="mt-3" style="font-size:0.9rem; color:#444;">
                    <strong>Ví MoMo:</strong> 0909 88 6868 <br />
                    <strong>Chủ tài khoản:</strong> SHOP XE MÁY CAO CẤP – VIETMOTO <br />
                    <strong>Số tiền cọc:</strong>
                    <span class="deposit-amount-big">
                        @soTienCoc.ToString("N0") đ
                    </span><br />
                    <strong>Nội dung chuyển khoản:</strong> <span class="text-primary fw-bold">@transferNote</span>
                </div>

                <div class="text-muted small mt-2">
                    (QR chỉ mang tính minh hoạ, không thực hiện chuyển khoản thật)
                </div>
            </div>

            <p class="text-center mb-4">
                <a href="#"
                   data-bs-toggle="modal"
                   data-bs-target="#DepositPolicyModal"
                   class="fw-semibold text-decoration-underline" style="color:@primaryPink;">
                    <i class="bi bi-info-circle-fill me-1"></i> Xem quy định đặt cọc (điều kiện hoàn / mất cọc)
                </a>
            </p>

            <p class="text-muted small text-center mb-3">
                Trạng thái cọc hiện tại: <strong class="text-dark">@Model.TrangThaiCoc</strong>
            </p>

            @if (isWaiting)
            {
                <div class="deposit-status-box waiting">
                    <strong><i class="bi bi-clock-fill me-1"></i> Đang chờ shop xác nhận.</strong><br />
                    Bạn đã báo đã chuyển khoản lúc
                    @Model.ThoiGianYeuCauCoc?.ToString("dd/MM/yyyy HH:mm").<br />
                    <span class="fw-semibold">Ghi chú:</span> @Model.GhiChuCoc
                </div>
            }
            else if (isDone)
            {
                <div class="deposit-status-box success">
                    <strong><i class="bi bi-check-circle-fill me-1"></i> Đã xác nhận đặt cọc thành công.</strong><br />
                    @(Model.ThoiGianXacNhanCoc.HasValue
                        ? Model.ThoiGianXacNhanCoc.Value.ToString("dd/MM/yyyy HH:mm")
                        : " (Thời gian chưa được ghi nhận)")
                    .<br />
                    Số tiền cọc sẽ được trừ vào số tiền còn lại khi nhận xe.
                </div>
            }

            @if (!isDone)
            {
                <form asp-action="YeuCauXacNhanCoc"
                      asp-controller="Orders"
                      method="post"
                      class="mt-4 pt-3 border-top border-light">

                    <input type="hidden" name="orderId" value="@Model.MaDH" />

                    <div class="mb-3">
                        <label for="NoteInput" class="form-label fw-semibold text-dark">
                            <i class="bi bi-pencil-square me-1"></i> Ghi chú cho shop
                        </label>
                        <textarea name="note"
                                  id="NoteInput"
                                  class="form-control"
                                  rows="2"
                                  placeholder="Tên chủ tài khoản, giờ chuyển khoản, nội dung chuyển khoản...">@Model.GhiChuCoc</textarea>
                    </div>

                    <button type="submit" class="btn btn-pink btn-lg w-100">
                        <i class="bi bi-send-fill me-1"></i>
                        @(isNew
                            ? "TÔI ĐÃ CHUYỂN KHOẢN, CHỜ SHOP XÁC NHẬN"
                            : "CẬP NHẬT / GỬI LẠI THÔNG TIN CHUYỂN KHOẢN")
                    </button>
                    <p class="text-muted small text-center mt-2 mb-0">
                        *Lưu ý: Bạn chỉ cần gửi thông báo một lần duy nhất.
                    </p>
                </form>
            }
        </div>

        <div class="deposit-summary">
            <div class="deposit-section-title mb-2">Tóm tắt thanh toán</div>
            <p class="mb-1 text-dark">Tổng đơn tạm tính: <strong class="float-end">@tongDon.ToString("N0") đ</strong></p>
            <p class="mb-1 text-dark">Số tiền đặt cọc: <strong class="float-end" style="color: @primaryPink;">@soTienCoc.ToString("N0") đ</strong></p>
            <hr class="my-2">
            <p class="mb-0 fs-6 text-dark">**Còn lại ước tính khi nhận xe:** <strong class="float-end text-success fs-5">@conLai.ToString("N0") đ</strong></p>
        </div>
    </div>
</div>

<div class="modal fade" id="DepositPolicyModal" tabindex="-1" aria-labelledby="DepositPolicyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #fce4ec;">
                <h5 class="modal-title fw-bold" id="DepositPolicyModalLabel" style="color: @primaryPink;">
                    <i class="bi bi-file-text-fill me-2"></i> QUY ĐỊNH ĐẶT CỌC KHI MUA XE
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="font-size: 0.9rem; line-height: 1.6;">
                <p> (Nội dung quy định giữ nguyên như code cũ) </p>
            </div>
            <div class="modal-footer" style="background-color: #fce4ec;">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Lấy thông báo từ TempData của Controller (Nếu có)
    var successMsg = '@Html.Raw(TempData["SuccessMessage"])';
        var errorMsg = '@Html.Raw(TempData["ErrorMessage"])';

        if (successMsg) {
            Swal.fire({
                title: 'Thành công!',
                text: successMsg,
                icon: 'success',
                confirmButtonText: 'Đã hiểu',
                confirmButtonColor: '#e91e63', // Màu hồng
                backdrop: `
                    rgba(0,0,123,0.4)
                    left top
                    no-repeat
                `
            });
        }

        if (errorMsg) {
            Swal.fire({
                title: 'Lỗi!',
                text: errorMsg,
                icon: 'error',
                confirmButtonText: 'Đóng'
            });
        }
    });
</script>