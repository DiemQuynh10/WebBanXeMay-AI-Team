@model IEnumerable<WebBanXeMay.Models.UuDai>
@using WebBanXeMay.Models

@{
    ViewData["Title"] = "Ưu Đãi Tháng Này";
}

<div class="mx-auto max-w-screen-xl px-4 md:px-6 py-8">

    <div class="text-center mb-10">
        <h1 class="text-4xl md:text-5xl font-extrabold text-pink-600 mb-2">🔥 Ưu Đãi Tháng Này 🔥</h1>
        <p class="text-lg text-gray-600">Nhanh tay sở hữu xe xịn với giá cực hời. Các ưu đãi chỉ có trong tháng này!</p>
    </div>

    @if (Model.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            @foreach (var deal in Model)
            {
                <div class="bg-white border border-gray-200 rounded-2xl shadow-lg overflow-hidden flex flex-col transition-all duration-300 hover:shadow-xl hover:-translate-y-1">

                    <div class="w-full h-48 bg-gray-100 flex items-center justify-center overflow-hidden">
                        @if (!string.IsNullOrEmpty(deal.HinhAnhUrl))
                        {
                            <img src="@deal.HinhAnhUrl" class="w-full h-full object-contain" alt="@deal.TenUuDai">
                        }
                        else
                        {
                            <img src="https://via.placeholder.com/400x250.png?text=DEAL" class="w-full h-full object-contain" alt="Deal image">
                        }
                    </div>
                    <div class="p-5 flex flex-col flex-grow">
                        <h5 class="text-xl font-bold text-gray-900 mb-2">@deal.TenUuDai</h5>
                        <p class="text-gray-600 text-sm mb-4 flex-grow">@deal.MoTa</p>

                        <div class="bg-pink-100 text-pink-700 p-3 rounded-lg mb-4">
                            <strong class="font-semibold">
                                @if (deal.LoaiKM == LoaiKhuyenMai.PhanTram)
                                {
                                    <span>Giảm @deal.GiaTri.ToString("0")%</span>
                                }
                                else if (deal.LoaiKM == LoaiKhuyenMai.SoTienGiam)
                                {
                                    <span>Giảm @deal.GiaTri.ToString("N0") VNĐ</span>
                                }
                                else if (deal.LoaiKM == LoaiKhuyenMai.QuaTang)
                                {
                                    <span>Tặng quà: @deal.TenUuDai</span>
                                }
                            </strong>
                        </div>

                        <p class="text-sm text-red-600 font-medium mb-3">
                            <strong>Áp dụng:</strong>
                            @if (deal.SanPham != null)
                            {
                                <span>Cho sản phẩm: @deal.SanPham.TenSP</span>
                            }
                            else if (deal.ThuongHieu != null)
                            {
                                <span>Cho thương hiệu: @deal.ThuongHieu.TenTH</span>
                            }
                            else if (deal.Loai != null)
                            {
                                <span>Cho loại xe: @deal.Loai.TenLoai </span>
                            }
                            else
                            {
                                <span>Cho tất cả sản phẩm</span>
                            }
                        </p>

                        <p class="text-gray-500 text-xs"><small>Hiệu lực đến: @deal.NgayKetThuc.ToString("dd/MM/yyyy")</small></p>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-16 px-6 bg-white border border-gray-200 rounded-2xl shadow-sm">
            <div class="mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-20 h-20 mx-auto text-pink-300">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 0 0 5.636 5.636m12.728 12.728A9 9 0 0 1 5.636 5.636m12.728 12.728L5.636 5.636m15.383-3.033a1.125 1.125 0 0 1 0 1.59l-2.639 2.64c-.22.22-.513.326-.826.326h-3.131a1.125 1.125 0 0 1-1.125-1.125v-3.13c0-.314.106-.607.326-.827l2.64-2.64a1.125 1.125 0 0 1 1.59 0l2.121 2.121z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125V4.125c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v2.25c0 .621.504 1.125 1.125 1.125Z" />
                </svg>
            </div>

            <h3 class="text-2xl font-bold text-gray-800 mb-2">Rất tiếc, hiện tại chưa có ưu đãi nào!</h3>
            <p class="text-gray-500 mb-6 max-w-md mx-auto">
                Các ưu đãi của tháng này đã được cập nhật hết.
                Vui lòng quay lại sau hoặc tham khảo các sản phẩm tuyệt vời khác của chúng tôi.
            </p>

            <a asp-controller="Home" asp-action="Index"
               class="inline-block px-6 py-3 rounded-lg bg-pink-600 text-white font-semibold hover:bg-pink-700 transition duration-300">
                Quay về Trang chủ
            </a>
        </div>
    }

</div>