@model WebBanXeMay.Models.ViewModels.CheckoutVM
@{
    ViewData["Title"] = "Thanh toán";
    var items = (List<WebBanXeMay.Models.ViewModels.CartItem>)ViewBag.Items;
    var subTotal = (decimal)ViewBag.SubTotal;
    var shipping = (decimal)ViewBag.Shipping;
    var total = (decimal)ViewBag.Total;
    var ids = (string)ViewBag.Ids;

    // Lấy danh sách voucher có sẵn
    var vouchers = ViewBag.AvailableVouchers as List<WebBanXeMay.Models.Voucher>;
}

<section class="mx-auto max-w-6xl px-4 py-6">
    <!-- Breadcrumb -->
    <nav class="mb-6 text-sm text-gray-500">
        <ol class="flex items-center gap-2">
            <li><a href="/" class="hover:text-pink-600">Trang chủ</a></li>
            <li>›</li>
            <li><a href="/cart" class="hover:text-pink-600">Giỏ hàng</a></li>
            <li>›</li>
            <li class="text-gray-900 font-medium">Thanh toán</li>
        </ol>
    </nav>

    <h1 class="text-2xl font-bold mb-4">Thanh toán</h1>

    @if (!User.Identity?.IsAuthenticated ?? true)
    {
        <div class="mb-5 rounded-xl border border-yellow-200 bg-yellow-50 px-4 py-3 text-sm">
            Bạn đã có tài khoản?
            <a class="underline text-blue-700"
               href="/Identity/Account/Login?returnUrl=@Uri.EscapeDataString($"/checkout?ids={ids}")">Đăng nhập</a>
            hoặc
            <a class="underline text-blue-700"
               href="/Identity/Account/Register?returnUrl=@Uri.EscapeDataString($"/checkout?ids={ids}")">Đăng ký</a>
            để tiếp tục đặt hàng.
        </div>
    }

    <!-- layout: trái 3/5, phải 2/5 -->
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-6">
        <!-- LEFT: form -->
        <div class="lg:col-span-3">
            <div class="rounded-2xl border bg-white shadow-sm">
                <div class="border-b px-5 py-4 bg-pink-50 rounded-t-2xl">
                    <h2 class="text-lg font-semibold text-gray-800">
                         Thông tin thanh toán
                    </h2>
                </div>
                <div class="px-5 py-5">
                    <form asp-controller="Checkout" asp-action="PlaceOrder" method="post" class="space-y-4">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="ids" value="@ids" />

                        <!-- hidden để gửi voucher về server -->
                        <input type="hidden" name="VoucherId" id="VoucherId" />
                        <input type="hidden" name="VoucherCode" id="VoucherCode" />
                        <input type="hidden" name="VoucherDiscount" id="VoucherDiscount" />
                        <!-- total gốc để JS dùng tính toán -->
                        <input type="hidden" id="BaseTotal" value="@total.ToString(System.Globalization.CultureInfo.InvariantCulture)" />

                        <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 mb-2"></div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium mb-1">Họ tên người nhận</label>
                                <input asp-for="NguoiNhan" class="w-full rounded-lg border px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-500" />
                                <span asp-validation-for="NguoiNhan" class="text-xs text-red-600"></span>
                            </div>
                            <div>
                                <label class="block text-sm font-medium mb-1">Số điện thoại</label>
                                <input asp-for="Phone" class="w-full rounded-lg border px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-500" />
                                <span asp-validation-for="Phone" class="text-xs text-red-600"></span>
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-medium mb-1">Địa chỉ</label>
                            <textarea asp-for="DiaChi" rows="3" class="w-full rounded-lg border px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-500"></textarea>
                            <span asp-validation-for="DiaChi" class="text-xs text-red-600"></span>
                        </div>

                        <!-- ====== PHƯƠNG THỨC THANH TOÁN (cân lại) ====== -->
                        <div class="rounded-xl border border-pink-100 bg-pink-50/70 px-4 py-3 space-y-2">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-2 text-sm text-gray-800">
                                    <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-pink-100 text-pink-500">
                                        <i class="fas fa-wallet text-xs"></i>
                                    </span>
                                    <span class="font-semibold">Phương thức thanh toán</span>
                                </div>
                                <span class="inline-flex items-center rounded-full border border-green-200 bg-green-50 px-3 py-1 text-[11px] font-medium text-green-700">
                                    COD mặc định
                                </span>
                            </div>

                            <div class="mt-1 flex items-center justify-between gap-4">
                                <div class="text-sm font-medium text-gray-800">
                                    Thanh toán khi nhận hàng (COD)
                                </div>
                            </div>
                            <div class="text-xs text-gray-500">
                                Bạn sẽ thanh toán phần còn lại khi nhận xe tại cửa hàng hoặc tại địa chỉ giao hàng (sau khi trừ số tiền đặt cọc).
                            </div>
                        </div>
                        <!-- ====== /PHƯƠNG THỨC THANH TOÁN ====== -->
                        <!-- ====== ĐẶT CỌC (THEO QUY ĐỊNH 10–20%) ====== -->
                        <div class="rounded-xl border border-gray-100 bg-white px-4 py-4 space-y-3">
                            <div class="flex items-start justify-between gap-4">
                                <div>
                                    <div class="flex items-center gap-2">
                                        <div class="font-semibold text-gray-800">Số tiền đặt cọc</div>
                                        <button type="button"
                                                onclick="toggleDepositRule()"
                                                class="text-[11px] text-pink-600 hover:text-pink-700 underline">
                                            Xem quy định đặt cọc
                                        </button>
                                    </div>
                                    <div class="text-xs md:text-sm text-gray-600">
                                        Số tiền đặt cọc thông thường trong khoảng
                                        <strong>10% – 20% giá trị xe</strong> (tùy model và thời điểm).<br />
                                        Mức cọc cụ thể của đơn này được hiển thị bên phải và
                                        sẽ được trừ trực tiếp vào hóa đơn khi nhận xe.
                                    </div>
                                </div>
                                <div class="text-right">
                                    <div class="text-pink-600 font-bold text-lg">
                                        @(((decimal)(ViewBag.Deposit ?? 0m)).ToString("n0")) đ
                                    </div>
                                </div>
                            </div>

                            <!-- QUY ĐỊNH ĐẶT CỌC (tóm tắt từ DepositPolicy.cshtml) -->
                            <div id="DepositRulePanel"
                                 class="hidden mt-2 rounded-lg border border-pink-100 bg-pink-50 px-3 py-2 text-[11px] md:text-xs text-gray-700 space-y-2">
                                <div class="font-semibold text-gray-800 mb-1">
                                    Tóm tắt quy định đặt cọc khi mua xe
                                </div>

                                <ol class="list-decimal list-inside space-y-1">
                                    <li><strong>Khi nào cần đặt cọc:</strong> áp dụng cho đơn từ 20.000.000đ trở lên hoặc theo yêu cầu của chương trình.</li>
                                    <li><strong>Mức tiền đặt cọc:</strong> thường nằm trong khoảng <strong>10% – 20% giá trị xe</strong>, tùy model và thời điểm.</li>
                                    <li><strong>Trường hợp được hoàn cọc:</strong> cửa hàng không còn đúng mẫu/phiên bản/màu xe bạn đặt, hoặc lỗi từ phía cửa hàng.</li>
                                    <li><strong>Trường hợp có thể mất cọc:</strong> khách tự ý hủy đơn, không đến nhận xe trong thời gian hẹn mà không báo trước, hoặc vi phạm điều kiện chương trình khuyến mãi.</li>
                                    <li><strong>Các trạng thái cọc trong hệ thống:</strong> Đã đặt cọc, Đã hoàn cọc, Mất cọc… được hiển thị rõ trên chi tiết đơn hàng.</li>
                                </ol>

                                <p class="text-[11px] text-green-700 mt-1">
                                    Khi trạng thái là <strong>“Đã hoàn cọc”</strong>, tiền cọc sẽ được trả lại theo đúng phương thức bạn đã dùng để thanh toán.
                                </p>
                            </div>

                            <div>
                                <label class="block text-sm font-medium mb-1">Phương thức đặt cọc</label>
                                <select asp-for="PhuongThucCoc"
                                        class="w-full rounded-lg border px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-500"
                                        required>
                                    <option value="MoMo">Ví MoMo</option>
                                    <option value="VNPay">VNPay</option>
                                    <option value="ChuyenKhoan">Chuyển khoản ngân hàng</option>
                                </select>
                            </div>

                            <div class="mt-2 flex items-start gap-2">
                                <input asp-for="AgreeDeposit"
                                       class="mt-1 h-4 w-4 rounded border-gray-300 text-pink-600 focus:ring-pink-500" />
                                <label for="AgreeDeposit" class="text-xs md:text-sm text-gray-700">
                                    Tôi đã đọc và đồng ý với quy định đặt cọc, bao gồm mức cọc 10–20% giá trị xe
                                    và các trường hợp được hoàn / không hoàn cọc.
                                </label>
                            </div>
                            <span asp-validation-for="AgreeDeposit" class="text-xs text-red-600"></span>
                        </div>

                        <!-- ====== /ĐẶT CỌC ====== -->

                        <!-- thanh toán giống Shopee: bar dưới -->
                        <div class="mt-2 flex flex-col md:flex-row md:items-center md:justify-between gap-3 rounded-xl bg-pink-50 px-4 py-3">
                            <div class="text-xs md:text-sm text-gray-700">
                                <div>Phương thức: <span class="font-semibold text-pink-600">COD + Đặt cọc</span></div>
                                <div>Giá xe, ưu đãi và phí sẽ được nhân viên xác nhận lại trước khi giao xe.</div>
                            </div>
                            <button type="submit"
                                    class="w-full md:w-auto rounded-xl bg-pink-600 px-8 py-3 text-sm font-semibold text-white hover:bg-pink-700 transition">
                                Đặt hàng
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- RIGHT: order summary + voucher -->
        <aside class="lg:col-span-2">
            <div class="rounded-2xl border bg-white shadow-sm lg:sticky lg:top-24 overflow-hidden">
                <!-- header -->
                <div class="border-b px-5 py-3 bg-pink-50 flex items-center justify-between">
                    <h2 class="text-base font-semibold text-gray-800">Đơn hàng của bạn</h2>
                    <span class="text-xs text-gray-500">
                        @items.Count sản phẩm
                    </span>
                </div>

                <div class="px-5 py-4 space-y-4">
                    <!-- items -->
                    <div class="space-y-3">
                        @foreach (var it in items)
                        {
                            <div class="flex items-center gap-3">
                                <img src="@(string.IsNullOrWhiteSpace(it.ImageUrl) ? Url.Content("~/images/hero-showroom.jpg") : Url.Content(it.ImageUrl))"
                                     class="h-14 w-14 rounded-lg border object-cover" />
                                <div class="min-w-0 flex-1">
                                    <div class="truncate text-sm font-medium text-gray-800">@it.TenSP</div>
                                    <div class="text-xs text-gray-500">x @it.SoLuong</div>
                                </div>
                                <div class="text-sm font-semibold whitespace-nowrap text-gray-800">
                                    @((it.Gia * it.SoLuong).ToString("n0")) đ
                                </div>
                            </div>
                        }
                    </div>

                    <hr class="my-2" />

                    <!-- VOUCHER -->
                    <div class="rounded-xl border border-pink-100 bg-pink-50 px-4 py-3 space-y-2">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2 text-sm text-gray-800">
                                <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-pink-100 text-pink-500">
                                    <i class="fas fa-ticket-alt text-xs"></i>
                                </span>
                                <span class="font-medium">Mã giảm giá</span>
                            </div>

                            <button type="button"
                                    onclick="toggleVoucherList()"
                                    class="text-xs font-semibold text-pink-600 hover:text-pink-700">
                                Chọn / xem mã
                            </button>
                        </div>

                        <div class="flex gap-2">
                            <input id="VoucherInput"
                                   class="flex-1 rounded-lg border border-pink-200 bg-white px-3 py-2 text-xs md:text-sm focus:outline-none focus:ring-2 focus:ring-pink-500"
                                   placeholder="Nhập mã voucher của bạn..." />

                            <button type="button"
                                    onclick="applyVoucher()"
                                    class="rounded-lg bg-pink-600 px-4 py-2 text-xs md:text-sm font-semibold text-white hover:bg-pink-700">
                                Áp dụng
                            </button>
                        </div>

                        <p id="VoucherMessage" class="text-xs text-gray-600"></p>

                        <div id="VoucherListPanel"
                             class="hidden mt-1 rounded-lg border border-pink-100 bg-white py-2 max-h-60 overflow-y-auto shadow-sm">
                            @if (vouchers != null && vouchers.Any())
                            {
                                <div class="px-3 pb-1 text-xs text-gray-500">
                                    Mã có thể áp dụng cho đơn này:
                                </div>

                                @foreach (var v in vouchers)
                                {
                                    <div class="voucher-item flex items-center justify-between px-3 py-2 hover:bg-pink-50 transition">
                                        <div class="pr-2">
                                            <div class="text-xs font-semibold text-pink-700">@v.MaVoucher</div>
                                            <div class="text-[11px] text-gray-600">
                                                @(string.IsNullOrWhiteSpace(v.TenVoucher) ? "Ưu đãi" : v.TenVoucher)
                                            </div>
                                            <div class="text-[11px] text-gray-400">
                                                @if (v.IsPercent)
                                                {
                                                    @($"{v.GiaTri}% • Tối đa {(v.GiaTriGiamToiDa ?? 0).ToString("n0")}đ")
                                                }
                                                else
                                                {
                                                    @($"{v.GiaTri.ToString("n0")}đ")
                                                }
                                                @if (v.DonHangToiThieu.HasValue)
                                                {
                                                    @($" • Đơn tối thiểu {v.DonHangToiThieu.Value.ToString("n0")}đ")
                                                }
                                            </div>
                                        </div>

                                        <button type="button"
                                                onclick="useVoucherCode('@v.MaVoucher')"
                                                class="shrink-0 rounded-full border border-pink-500 px-3 py-1 text-xs font-semibold text-pink-600 hover:bg-pink-100">
                                            Dùng mã
                                        </button>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="px-3 py-2 text-xs text-gray-500">
                                    Hiện chưa có voucher nào phù hợp cho đơn này.
                                </div>
                            }
                        </div>
                    </div>

                    <!-- totals -->
                    <div class="mt-1 rounded-xl border border-gray-100 bg-gray-50 px-4 py-3 space-y-1 text-sm">
                        <div class="flex items-center justify-between">
                            <span class="text-gray-600">Tạm tính</span>
                            <span class="font-medium text-gray-800">@subTotal.ToString("n0") đ</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-gray-600">Phí ship</span>
                            <span class="font-medium text-gray-800">
                                @(shipping == 0 ? "0 đ (Miễn phí)" : shipping.ToString("n0") + " đ")
                            </span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-gray-600">Giảm giá</span>
                            <span id="VoucherDiscountText" class="font-medium text-green-600">
                                - 0 đ
                            </span>
                        </div>
                        <div class="h-px bg-gray-200 my-1"></div>
                        <div class="flex items-center justify-between">
                            <span class="text-sm font-semibold text-gray-800">Tổng tiền</span>
                            <span id="FinalTotalText" class="text-lg font-bold text-pink-600">
                                @total.ToString("n0") đ
                            </span>
                        </div>
                    </div>

                    <div class="text-[11px] text-gray-500">
                        * Miễn phí vận chuyển cho đơn từ 20.000.000đ.  
                        * Giá, phí đăng ký, khuyến mãi cụ thể sẽ được nhân viên tư vấn lại trước khi giao xe.
                    </div>
                </div>
            </div>
        </aside>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function formatCurrency(v) {
            if (isNaN(v)) return "0 đ";
            return v.toLocaleString('vi-VN');
        }

        function toggleVoucherList() {
            const panel = document.getElementById("VoucherListPanel");
            panel.classList.toggle("hidden");
        }

        function useVoucherCode(code) {
            document.getElementById("VoucherInput").value = code;
            applyVoucher();
        }

        function toggleDepositRule() {
            const panel = document.getElementById("DepositRulePanel");
            panel.classList.toggle("hidden");
        }

        function applyVoucher() {
            var code = document.getElementById("VoucherInput").value.trim();
            var baseTotal = parseFloat(document.getElementById("BaseTotal").value);

            var msgEl = document.getElementById("VoucherMessage");
            var discountEl = document.getElementById("VoucherDiscountText");
            var finalEl = document.getElementById("FinalTotalText");

            if (!code) {
                msgEl.className = "text-xs text-red-600 mt-1";
                msgEl.textContent = "Vui lòng nhập mã giảm giá.";
                return;
            }

            $.post("/Voucher/Apply", { code: code, orderTotal: baseTotal })
                .done(function (res) {
                    if (!res.success) {
                        $("#VoucherId").val("");
                        $("#VoucherCode").val("");
                        $("#VoucherDiscount").val("0");

                        msgEl.className = "text-xs text-red-600 mt-1";
                        msgEl.textContent = res.message || "Không áp dụng được voucher.";

                        discountEl.textContent = "- 0 đ";
                        finalEl.textContent = formatCurrency(baseTotal) + " đ";
                        return;
                    }

                    msgEl.className = "text-xs text-green-600 mt-1";
                    msgEl.textContent = res.message || "Áp dụng voucher thành công.";

                    $("#VoucherId").val(res.voucherId);
                    $("#VoucherCode").val(res.code);
                    $("#VoucherDiscount").val(res.discount);

                    discountEl.textContent = "- " + formatCurrency(res.discount) + " đ";
                    finalEl.textContent = formatCurrency(res.final) + " đ";
                })
                .fail(function () {
                    msgEl.className = "text-xs text-red-600 mt-1";
                    msgEl.textContent = "Lỗi hệ thống, vui lòng thử lại.";
                });
        }
    </script>

    <style>
        .voucher-item + .voucher-item {
            border-top: 1px solid #fce4ec;
        }
    </style>
}
